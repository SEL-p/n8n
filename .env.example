# ================================================
# Configuration Digisys n8n — Variables d'environnement
# ================================================
# Copiez ce fichier en .env et renseignez vos valeurs :
#   cp .env.example .env
#   nano .env

# ---------- Accès ----------
# MODE IP (sans domaine) : renseignez votre IP publique
# Exemple : SERVER_IP=191.215.42.54
SERVER_IP=191.215.42.54

# MODE DOMAINE (quand vous aurez un domaine) :
# Décommentez les 2 lignes suivantes et commentez SERVER_IP
# SUBDOMAIN=n8n
# DOMAIN_NAME=votredomaine.com

# ---------- Fuseau horaire (Côte d'Ivoire) ----------
GENERIC_TIMEZONE=Africa/Abidjan

# ---------- Sécurité ----------
# Clé de chiffrement pour les credentials stockées dans n8n (OBLIGATOIRE en production)
# Générez-en une avec :  openssl rand -hex 32
N8N_ENCRYPTION_KEY=
